{
  "manifestVersion": 1,
  "id": "teresa.unified",
  "type": "ui",
  "name": "Teresa Unified",
  "version": "1.0.0",
  "description": "Unified AIO layout with hero banners, collections, and UI configuration.",
  "logo": "https://i.imgur.com/5QFQK8R.png",

  "ui": {
    "provider": "layout"
  },

  "behaviorHints": {
    "configurable": false,
    "needsConfiguration": false
  },

  "resources": [
    {
      "name": "config",
      "type": "other",
      "url": "./aio-config.json"
    },
    {
      "name": "collections",
      "type": "other",
      "url": "./collections.json"
    },
    {
      "name": "layout",
      "type": "ui",
      "url": "./layout.json"
    }
  ],

  "config": {
    "layout": "hero",
    "showHeroBanners": true,
    "showTrending": true,
    "showNewReleases": true,
    "showContinueWatching": true
  },

  "collections": [
    {
      "name": "Streaming Services",
      "items": [
        "Netflix",
        "Prime Video",
        "Disney+",
        "HBO Max",
        "Hulu
