      "items": [
        "Netflix",
        "Prime Video",
        "Disney+",
        "HBO Max",
        "Hulu",
        "Paramount+"
      ]
    },
    {
      "name": "Genres",
      "items": [
        "Action",
        "Comedy",
        "Drama",
        "Horror",
        "Sci-Fi",
        "Romance"
      ]
    }
  ]
}
