{
  "manifestVersion": 1,
  "id": "teresa.unified.collections",
  "type": "other",
  "name": "Teresa Unified Collections",
  "version": "1.0.0",
  "description": "Custom streaming service and genre collections for Teresa.",
  "logo": "https://i.imgur.com/5QFQK8R.png",

